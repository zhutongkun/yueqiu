<?xml version="1.0"?>
<!--自动拾取-->
<launch>
    <arg name="debug"               default="false"/>
    <arg name="broadcast"           default="false"/>
    <arg name="target_color" default="red" />
    <arg name="map"         default="explore"/>
    <arg name="app"         default="false"/>
    <arg name="sim"         default="false"/>
    <arg name="master_name"  default="/"/>
    <arg name="robot_name"   default="/"/>
    <arg name="frame_prefix"  default="/"/>
    <arg name="drive_type"  default="diff-corrected"/>

    <arg name="start"   default="true"/>
    <arg name="color"   default="red"/>
    <arg name="node_name" default="yolov8" />

    <arg name="map_frame"    default="map"/>

    <!--自定义深度摄像头名称(custom depth camera name)-->
    <arg name="depth_camera_name"   default="depth_cam"/>

    <!--自定义深度摄像头rgb话题名称(custom depth camera rgb topic name)-->
    <arg name="image_topic"         default="image_raw"/>

    <rosparam file="$(find agripicking)/config/config.yaml" command="load"/>
    <!--麦克风节点-->
    <include file="$(find xf_mic_asr_offline)/launch/mic_init.launch"/>

    <!--读取地图节点-->
    <include file="$(find navigation)/launch/include/load_map.launch">
        <arg name="map"         value="$(arg map)"/>
        <arg name="robot_name"  value="$(arg robot_name)"/>
    </include>

    <!--机器人控制节点-->
    <include file="$(find slam)/launch/include/robot.launch">
        <arg name="sim"         value="$(arg sim)"/>
        <arg name="app"         value="$(arg app)"/>
        <arg name="use_joy"     value="false"/>
        <arg name="robot_name"  value="$(arg robot_name)"/>
        <arg name="master_name" value="$(arg master_name)"/>
    </include>

    <!-- YOLOV8 -->
    <arg name="use_astra_camera" default="true" />
    <rosparam param="/$(arg node_name)/classes">['red_fruit','green_fruit','red_tag','green_tag']</rosparam>
    <node pkg="agripicking" type="yolov11_node.py" name="$(arg node_name)" output="screen">
        <param name="engine"        value="best_agripicking.engine"/>
        <param name="lib"           value="libmyplugins.so"/>
        <param name="conf_thresh"   value="0.75"/>
        <param name="use_astra_camera"   value="$(arg use_astra_camera)"/>
    </node>

    <!--运动学节点(chassis driver)-->
    <include file="$(find agripicking)/launch/kinematics_node.launch">
    </include>

    <!--启动导航-->
    <include file="$(find agripicking)/launch/include/navigation_base.launch">
        <arg name="drive_type"  value="$(arg drive_type)"/>
        <arg name="robot_name"  value="$(arg robot_name)"/>
        <arg name="master_name" value="$(arg master_name)"/>
    </include>


    <!--果实识别-->
    <node pkg="agripicking" type="agricultural_picking.py" name="agricultural_picking" output="screen">
        <param name="color" value="$(arg color)"/>
    </node>
    <!--总控制-->
    <node name="mission_start" pkg="agripicking" type="mission_start.py" output="screen" ns='$(arg master_name)'>
        <param name="map_frame" value="$(arg map_frame)"/>
    </node>

    <include file="$(find agripicking)/launch/rviz_navigation.launch"/>
</launch>
